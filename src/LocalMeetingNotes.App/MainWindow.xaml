<Window x:Class="LocalMeetingNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Local Meeting Notes" Height="560" Width="920" MinHeight="440" MinWidth="720">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Width="100" Height="34" Content="Settings" Command="{Binding OpenSettingsCommand}" />
            <StackPanel Orientation="Horizontal">
                <Button Width="125" Height="34" Margin="0,0,8,0" Command="{Binding StartCommand}" Content="Start recording" />
                <Button Width="110" Height="34" Margin="0,0,20,0" Command="{Binding StopCommand}" Content="Stop" />
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding ElapsedText}" />
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="10" Background="#FFF4CE" BorderBrush="#CC9A06" BorderThickness="1"
                Visibility="{Binding HasNoModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="No valid Whisper model was found. Recording still works; transcription will wait until a model is available." TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MicrophoneLevel, StringFormat={}{0:P0}}" />
                    <TextBlock Text="Microphone level" />
                </DockPanel>
                <ProgressBar Height="18" Minimum="0" Maximum="1" Value="{Binding MicrophoneLevel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SystemLevel, StringFormat={}{0:P0}}" />
                    <TextBlock Text="System audio level" />
                </DockPanel>
                <ProgressBar Height="18" Minimum="0" Maximum="1" Value="{Binding SystemLevel, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="3" Header="Recent meetings and queue">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Width="90" Margin="0,0,8,0" Content="Open" Command="{Binding OpenItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=SessionsList}" />
                    <Button Width="110" Margin="0,0,8,0" Content="Open folder" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=SessionsList}" />
                    <Button Width="120" Margin="0,0,8,0" Content="Copy full note" Command="{Binding CopyNoteCommand}" CommandParameter="{Binding SelectedItem, ElementName=SessionsList}" />
                    <Button Width="90" Content="Retry" Command="{Binding RetryCommand}" CommandParameter="{Binding SelectedItem, ElementName=SessionsList}" />
                </StackPanel>
                <ListView x:Name="SessionsList" ItemsSource="{Binding Sessions}" MouseDoubleClick="SessionsList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="300" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Status" Width="135" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Details" Width="320" DisplayMemberBinding="{Binding Detail}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
