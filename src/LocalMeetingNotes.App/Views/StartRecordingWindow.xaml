<Window x:Class="LocalMeetingNotes.App.Views.StartRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start recording"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Title:" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Top" Text="Participants:" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap"
                 ToolTip="Separate names with commas or new lines"
                 Text="{Binding Participants, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Top" Text="Context:" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                 Text="{Binding Context, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Top" Text="References:" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap"
                 ToolTip="Separate references with commas or new lines"
                 Text="{Binding References, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
            <Button Width="120" IsDefault="True" Click="Start_Click" Content="Start recording" />
        </StackPanel>
    </Grid>
</Window>
