<Window x:Class="LocalMeetingNotes.App.Views.StartRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New recording"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource FloorBrush}"
        UseLayoutRounding="True">
    <StackPanel Margin="26,22,26,22">
        <TextBlock Style="{StaticResource Heading}" Text="New recording" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                   Text="This metadata is written into the Markdown note." />

        <TextBlock Style="{StaticResource Caption}" Text="TITLE" Margin="0,0,0,6" />
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Caption}" Text="PARTICIPANTS" Margin="0,16,0,6" />
        <TextBox MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Text="{Binding Participants, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,5,0,0"
                   Text="Separate names with commas or new lines." />

        <TextBlock Style="{StaticResource Caption}" Text="CONTEXT" Margin="0,16,0,6" />
        <TextBox MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Text="{Binding Context, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Caption}" Text="REFERENCES" Margin="0,16,0,6" />
        <TextBox MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Text="{Binding References, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,5,0,0"
                   Text="Links or documents, one per line." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="18,8" />
            <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="18,8"
                    IsDefault="True" Click="Start_Click" Content="Start recording" />
        </StackPanel>
    </StackPanel>
</Window>
