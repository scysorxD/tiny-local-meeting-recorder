<Window x:Class="LocalMeetingNotes.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="640" Width="620" MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="General" Margin="0,0,0,8" />
            <TextBlock Text="Meetings folder" />
            <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseMeetingsFolderCommand}" />
                <TextBox Text="{Binding MeetingsFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,0,0,4" />
            <CheckBox Content="Close to tray" IsChecked="{Binding CloseToTray}" Margin="0,0,0,4" />
            <CheckBox Content="Delete audio after successful transcription" IsChecked="{Binding DeleteAudioAfterSuccess}" Margin="0,0,0,16" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Audio" Margin="0,0,0,8" />
            <TextBlock Text="Microphone" />
            <ComboBox Margin="0,4,0,8"
                      ItemsSource="{Binding Microphones}"
                      SelectedItem="{Binding SelectedMicrophone}"
                      DisplayMemberPath="FriendlyName" />
            <TextBlock Text="System output" />
            <ComboBox Margin="0,4,0,8"
                      ItemsSource="{Binding RenderDevices}"
                      SelectedItem="{Binding SelectedRenderDevice}"
                      DisplayMemberPath="FriendlyName" />
            <Button Width="120" HorizontalAlignment="Left" Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" Margin="0,0,0,16" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Whisper" Margin="0,0,0,8" />
            <TextBlock Text="Models folder" />
            <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseModelsFolderCommand}" />
                <TextBox Text="{Binding ModelsFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="Model" />
            <ComboBox Margin="0,4,0,8"
                      ItemsSource="{Binding Models}"
                      SelectedItem="{Binding SelectedModel}"
                      DisplayMemberPath="FileName" />
            <Button Width="120" HorizontalAlignment="Left" Content="Refresh models" Command="{Binding RefreshModelsCommand}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Language" />
            <ComboBox Margin="0,4,0,8" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
            <TextBlock Text="Transcription threads" />
            <TextBox Width="80" HorizontalAlignment="Left" Margin="0,4,0,16" Text="{Binding TranscriptionThreads}" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Configuration" Margin="0,0,0,8" />
            <Button Width="160" HorizontalAlignment="Left" Content="Open settings.json" Command="{Binding OpenSettingsFileCommand}" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal">
                <Button Width="100" Height="32" Margin="0,0,8,0" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
                <Button Width="100" Height="32" Content="Close" IsCancel="True" Click="Close_Click" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Text="{Binding StatusMessage}" />
        </StackPanel>
    </ScrollViewer>
</Window>
