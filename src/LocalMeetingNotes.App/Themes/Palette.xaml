<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="FloorColor">#FF0F1115</Color>
    <Color x:Key="SurfaceColor">#FF171A21</Color>
    <Color x:Key="SurfaceHighColor">#FF1E222B</Color>
    <Color x:Key="StrokeColor">#FF242832</Color>
    <Color x:Key="StrokeStrongColor">#FF333947</Color>
    <Color x:Key="TextColor">#FFE7E9EE</Color>
    <Color x:Key="MutedColor">#FF8A90A0</Color>
    <Color x:Key="AccentColor">#FF6E8BFF</Color>
    <Color x:Key="AccentDimColor">#FF5872E0</Color>
    <Color x:Key="DangerColor">#FFFF5F57</Color>
    <Color x:Key="SuccessColor">#FF4ADE80</Color>
    <Color x:Key="WarningColor">#FFF5B942</Color>

    <SolidColorBrush x:Key="FloorBrush" Color="{StaticResource FloorColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FF8AA0FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1F6E8BFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF232732" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FF3A4050" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#1FF5B942" />
    <SolidColorBrush x:Key="WarningStrokeBrush" Color="#4DF5B942" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>
</ResourceDictionary>
